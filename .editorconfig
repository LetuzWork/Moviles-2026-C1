root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{kt,kts}]
# Composable functions use PascalCase by convention
ktlint_function_naming_ignore_when_annotated_with = Composable,Preview

# Backing properties (_foo) are a standard Kotlin pattern for internal MutableStateFlow
ktlint_standard_backing-property-naming = disabled

# File-name rule is noisy when a file is intentionally renamed at class level
ktlint_standard_filename = disabled
