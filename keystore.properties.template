# Plantilla de configuración de firma del release.
#
# 1) Copiá este archivo a `keystore.properties` (que está gitignored).
# 2) Completá los valores con los de tu keystore.
#
# NO subir `keystore.properties` ni el .jks al repositorio (contienen credenciales).
#
# Para generar un keystore nuevo:
#   keytool -genkeypair -v -keystore keystore/menusemana-release.jks \
#     -alias menusemana -keyalg RSA -keysize 2048 -validity 10000
#
# En CI, en lugar de este archivo, definí las variables de entorno:
#   KEYSTORE_FILE, KEYSTORE_PASSWORD, KEY_ALIAS, KEY_PASSWORD

storeFile=keystore/menusemana-release.jks
storePassword=CAMBIAR
keyAlias=menusemana
keyPassword=CAMBIAR
